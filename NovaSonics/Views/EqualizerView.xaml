<UserControl x:Class="NovaSonics.Views.EqualizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="920">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
        <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">

            <!-- Title & Info Banner -->
            <Border Background="#1C1F26" CornerRadius="8" Padding="16,14" Margin="0,0,0,14" BorderBrush="#262A34" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="🎛️ Hardware Graphic Equalizer" FontSize="16" FontWeight="Black" Foreground="#00E5FF"/>
                            <Border Background="#1E3A5F" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Onboard Headset DSP (0x33)" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Directly configures the Arctis Nova 7 DAC hardware equalizer with zero latency and 0% CPU overhead."
                                   FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>

                    <!-- Save / Flash Burn Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="↺ Flat" Command="{Binding ResetFlatCommand}"
                                Padding="12,8" Margin="0,0,8,0" Background="#1E222B" BorderBrush="#334155" Foreground="#94A3B8" />
                        <Button Content="💾 Save to Headset" Command="{Binding ApplyToHeadsetCommand}"
                                Padding="16,8" Background="#00E5FF" Foreground="#0F172A" FontWeight="Bold" BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status Banner -->
            <Border Background="#152E3C" CornerRadius="6" Padding="12,8" Margin="0,0,0,14" BorderBrush="#0284C7" BorderThickness="1"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
            </Border>

            <!-- Main Equalizer Card -->
            <Border Background="#181A20" CornerRadius="8" Padding="18" BorderBrush="#262A34" BorderThickness="1">
                <StackPanel>
                    <!-- Preset Selector Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="PRESET:" FontWeight="Bold" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                  Height="32" FontSize="12"/>

                        <!-- Tuning Info -->
                        <TextBlock Grid.Column="2" Text="Range: -10.0 dB to +10.0 dB"
                                   FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 10-Band Sliders Rack -->
                    <Border Background="#111317" CornerRadius="8" Padding="12,18" BorderBrush="#20242D" BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding Bands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="210" />
                                            <RowDefinition Height="26" />
                                        </Grid.RowDefinitions>

                                        <!-- Live dB Value Badge -->
                                        <Border Grid.Row="0" Background="#1C212C" CornerRadius="4" Padding="3,1" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding FormattedGain}" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                                        </Border>

                                        <!-- Vertical Slider -->
                                        <Slider Grid.Row="1" Orientation="Vertical"
                                                Minimum="-10.0" Maximum="10.0"
                                                Value="{Binding GainDb, Mode=TwoWay}"
                                                TickFrequency="5" TickPlacement="Both"
                                                IsSnapToTickEnabled="False"
                                                HorizontalAlignment="Center"
                                                Height="200"
                                                Cursor="Hand"
                                                MouseWheel="Slider_MouseWheel"/>

                                        <!-- Frequency Badge -->
                                        <Border Grid.Row="2" Background="#181B22" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding FrequencyLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
