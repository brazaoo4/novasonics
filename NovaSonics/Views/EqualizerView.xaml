<UserControl x:Class="NovaSonics.Views.EqualizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">

            <!-- Title & Info Banner -->
            <Border Background="#1C1F26" CornerRadius="8" Padding="18" Margin="0,0,0,16" BorderBrush="#262A34" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🎛️ 10-Band Hardware Equalizer" FontSize="16" FontWeight="Black" Foreground="#00E5FF"/>
                            <Border Background="#1E3A5F" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Onboard Headset DSP (0x33)" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Directly configures the Arctis Nova 7 internal hardware DAC audio processor. Introduces 0ms audio latency, requires 0% CPU, and persists in headset non-volatile memory."
                                   FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Save / Flash Burn Button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="↺ Reset to Flat" Command="{Binding ResetFlatCommand}"
                                Padding="12,8" Margin="0,0,8,0" Background="#1E222B" BorderBrush="#334155" Foreground="#94A3B8" />
                        <Button Content="💾 Save to Headset Memory" Command="{Binding ApplyToHeadsetCommand}"
                                Padding="16,8" Background="#00E5FF" Foreground="#0F172A" FontWeight="Bold" BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status Banner -->
            <Border Background="#152E3C" CornerRadius="6" Padding="12,8" Margin="0,0,0,16" BorderBrush="#0284C7" BorderThickness="1"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
            </Border>

            <!-- Preset Selection & Tuning Card -->
            <Border Background="#181A20" CornerRadius="8" Padding="20" BorderBrush="#262A34" BorderThickness="1">
                <StackPanel>
                    <!-- Preset Selector Header -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="EQ Preset:" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                  Height="32" FontSize="12"/>

                        <!-- Tuning Info -->
                        <TextBlock Grid.Column="2" Text="Range: -10.0 dB to +10.0 dB (0.5 dB hardware steps)"
                                   FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 10-Band Vertical Sliders Rack -->
                    <Border Background="#111317" CornerRadius="8" Padding="16,24" BorderBrush="#20242D" BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding Bands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="220" />
                                            <RowDefinition Height="28" />
                                        </Grid.RowDefinitions>

                                        <!-- Live dB Value Badge -->
                                        <Border Grid.Row="0" Background="#1C212C" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding FormattedGain}" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                                        </Border>

                                        <!-- Vertical Slider -->
                                        <Slider Grid.Row="1" Orientation="Vertical"
                                                Minimum="-10.0" Maximum="10.0"
                                                Value="{Binding GainDb, Mode=TwoWay}"
                                                TickFrequency="2" TickPlacement="Both"
                                                IsSnapToTickEnabled="False"
                                                HorizontalAlignment="Center"
                                                Height="210"
                                                Cursor="Hand"/>

                                        <!-- Frequency Badge -->
                                        <Border Grid.Row="2" Background="#181B22" CornerRadius="4" Padding="4,3" HorizontalAlignment="Center" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding FrequencyLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Explanatory Presets Legend -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="🎯 Competitive FPS (Footsteps):" FontWeight="Bold" FontSize="11" Foreground="#38BDF8"/>
                            <TextBlock Text="Attenuates boomy sub-bass rumble (&lt;125Hz) and elevates 1kHz - 4kHz presence to highlight enemy footsteps, defuses, and reload cues."
                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="🎵 Bass Boost / Smiley (V-Shape):" FontWeight="Bold" FontSize="11" Foreground="#38BDF8"/>
                            <TextBlock Text="Provides deep punchy low-end punch for electronic, hip-hop, or cinematic games with sparkling high-frequency details."
                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
