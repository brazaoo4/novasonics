<UserControl x:Class="NovaSonics.Views.EqualizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:NovaSonics.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="980">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Segmented Mode Button Style -->
        <Style x:Key="SegmentedButton" TargetType="Button">
            <Setter Property="Background" Value="#1C1F26" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderBrush" Value="#2A303C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- Profile Selector Segmented Header (Game, Media, Voice, Custom) -->
            <Border Background="#16181F" CornerRadius="8" Padding="6" Margin="0,0,0,16" BorderBrush="#252A36" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Game Profile Button -->
                    <Button Grid.Column="0" Command="{Binding SelectProfileCommand}" CommandParameter="Game" Margin="3" Height="38">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SegmentedButton}">
                                <Setter Property="Content" Value="🎮 GAME" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProfile}" Value="Game">
                                        <Setter Property="Background" Value="#00E5FF" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                        <Setter Property="FontWeight" Value="Black" />
                                        <Setter Property="BorderBrush" Value="#00E5FF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Media Profile Button -->
                    <Button Grid.Column="1" Command="{Binding SelectProfileCommand}" CommandParameter="Media" Margin="3" Height="38">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SegmentedButton}">
                                <Setter Property="Content" Value="🎵 MEDIA" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProfile}" Value="Media">
                                        <Setter Property="Background" Value="#F59E0B" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                        <Setter Property="FontWeight" Value="Black" />
                                        <Setter Property="BorderBrush" Value="#F59E0B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Voice Profile Button -->
                    <Button Grid.Column="2" Command="{Binding SelectProfileCommand}" CommandParameter="Voice" Margin="3" Height="38">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SegmentedButton}">
                                <Setter Property="Content" Value="🎙️ VOICE" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProfile}" Value="Voice">
                                        <Setter Property="Background" Value="#10B981" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                        <Setter Property="FontWeight" Value="Black" />
                                        <Setter Property="BorderBrush" Value="#10B981" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Custom Profile Button -->
                    <Button Grid.Column="3" Command="{Binding SelectProfileCommand}" CommandParameter="Custom" Margin="3" Height="38">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SegmentedButton}">
                                <Setter Property="Content" Value="⚙️ CUSTOM" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProfile}" Value="Custom">
                                        <Setter Property="Background" Value="#A855F7" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                        <Setter Property="FontWeight" Value="Black" />
                                        <Setter Property="BorderBrush" Value="#A855F7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Status Banner -->
            <Border Background="#152E3C" CornerRadius="6" Padding="12,8" Margin="0,0,0,14" BorderBrush="#0284C7" BorderThickness="1"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
            </Border>

            <!-- 1. GRAPHIC EQUALIZER CARD (Hardware DAC EQ) -->
            <Border Background="#181A20" CornerRadius="8" Padding="18" BorderBrush="#262A34" BorderThickness="1" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Preset Selector Header & Save to Headset -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="PRESET:" FontWeight="Bold" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePresets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                  Height="32" FontSize="12"/>

                        <!-- Tuning Info -->
                        <TextBlock Grid.Column="2" Text="Hardware DAC EQ (10-Band) • Range: -10.0 dB to +10.0 dB"
                                   FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Reset & Hardware Burn Buttons -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="↺ Flat" Command="{Binding ResetFlatCommand}"
                                    Padding="12,6" Margin="0,0,8,0" Background="#1E222B" BorderBrush="#334155" Foreground="#94A3B8" />
                            <Button Content="💾 Save to Headset" Command="{Binding ApplyToHeadsetCommand}"
                                    Padding="14,6" Background="#00E5FF" Foreground="#0F172A" FontWeight="Bold" BorderThickness="0" />
                        </StackPanel>
                    </Grid>

                    <!-- 10-Band Sliders Rack -->
                    <Border Background="#111317" CornerRadius="8" Padding="12,18" BorderBrush="#20242D" BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding Bands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24" />
                                            <RowDefinition Height="220" />
                                            <RowDefinition Height="26" />
                                        </Grid.RowDefinitions>

                                        <!-- Live dB Value Badge -->
                                        <Border Grid.Row="0" Background="#1C212C" CornerRadius="4" Padding="3,1" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding FormattedGain}" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                                        </Border>

                                        <!-- Vertical Slider -->
                                        <Slider Grid.Row="1" Orientation="Vertical"
                                                Minimum="-10.0" Maximum="10.0"
                                                Value="{Binding GainDb, Mode=TwoWay}"
                                                TickFrequency="5" TickPlacement="Both"
                                                IsSnapToTickEnabled="False"
                                                HorizontalAlignment="Center"
                                                Height="210"
                                                Cursor="Hand"
                                                MouseWheel="Slider_MouseWheel"/>

                                        <!-- Frequency Badge -->
                                        <Border Grid.Row="2" Background="#181B22" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding FrequencyLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Explanatory footer -->
                    <TextBlock Text="Adjusting sliders updates the Arctis Nova 7 DAC volatile EQ immediately. Changes are automatically written to EEPROM after 2.5 seconds or immediately via 'Save to Headset'."
                               Foreground="#475569" FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Center" FontStyle="Italic"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
