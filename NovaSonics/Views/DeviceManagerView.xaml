<UserControl x:Class="NovaSonics.Views.DeviceManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:NovaSonics.ViewModels"
             xmlns:conv="clr-namespace:NovaSonics.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DeviceManagerViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Device Manager (Backup Device Switch)" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Text="Drag or arrange playback devices in priority order. When your Arctis Nova 7 powers on or off, NovaSonics switches audio immediately." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Two Columns: Priority List vs Excluded Devices -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- 1. Priority List -->
            <Border Grid.Column="0" Background="#1C1F26" CornerRadius="8" Padding="16" Margin="0,0,10,0" BorderBrush="#262A34" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="OUTPUT DEVICE PRIORITY LIST" FontWeight="Bold" FontSize="13" Foreground="#00E5FF" Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PriorityDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#16181F" CornerRadius="6" Padding="12,10" Margin="0,4" BorderBrush="#2D3340" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Order Number -->
                                            <TextBlock Text="⠿" FontSize="16" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <!-- Device Name & Badge -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="13"/>
                                                    <!-- Current Device Badge -->
                                                    <Border Background="#065F46" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                            Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="🟢 CURRENT DEVICE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Control Buttons (Move Up, Move Down, Set Default, Exclude) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Set Default" FontSize="11" Padding="8,3" Margin="2,0" Background="#1E293B" BorderBrush="#334155"
                                                        Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="▲" FontSize="11" Width="28" Height="26" Margin="2,0" Background="#1E293B" BorderBrush="#334155"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="▼" FontSize="11" Width="28" Height="26" Margin="2,0" Background="#1E293B" BorderBrush="#334155"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="✖" FontSize="11" Width="28" Height="26" Margin="2,0" Background="#7F1D1D" BorderBrush="#991B1B" ToolTip="Exclude device"
                                                        Command="{Binding DataContext.ExcludeDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 2. Excluded Devices -->
            <Border Grid.Column="1" Background="#1C1F26" CornerRadius="8" Padding="16" Margin="10,0,0,0" BorderBrush="#262A34" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="EXCLUDED DEVICES" FontWeight="Bold" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ExcludedDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#16181F" CornerRadius="6" Padding="12,10" Margin="0,4" BorderBrush="#262B36" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="12"/>
                                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#475569" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="↺ Include" FontSize="11" Padding="8,3" Background="#1E293B" BorderBrush="#334155"
                                                    Command="{Binding DataContext.RestoreDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Policy Toggles -->
        <Border Grid.Row="2" Background="#181B22" CornerRadius="8" Padding="16" Margin="0,16,0,0" BorderBrush="#262A34" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <CheckBox Content="Use the same device on all channels" IsChecked="{Binding UseSameDeviceOnAllChannels}" Foreground="#E2E8F0" Margin="16,0" FontSize="12"/>
                <CheckBox Content="Automatic backup switch at boot/reboot" IsChecked="{Binding AutoSwitchAtBoot}" Foreground="#E2E8F0" Margin="16,0" FontSize="12"/>
                <CheckBox Content="Auto-switch when Nova Wireless headset is powered off" IsChecked="{Binding AutoSwitchOnPowerOff}" Foreground="#E2E8F0" Margin="16,0" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
